# Copy this file to .env.local and fill in the values. .env.local is never committed.

# Supabase (public by design; row-level security protects the data).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Osmo's natural voice (OpenAI text-to-speech), used only by /api/speak.
# Server-only: it must NOT start with NEXT_PUBLIC_, or the browser would be able to read it.
# Without it, Osmo falls back to the device's built-in voice and nothing breaks.
# Paste the key after the "=" on the next line, with no quotes and no spaces:
OPENAI_API_KEY=

# Osmo's AI conversation (an OpenAI model writes his everyday replies), used only by /api/chat.
# All server-only: none of these may start with NEXT_PUBLIC_. Anything missing or malformed means
# off, and Osmo keeps his rule-based replies. The code has no defaults for the switch, the owner or
# the cap, and needs an OpenAI key, so it stays off until all of them are set.
# "on" (exactly) turns it on; anything else is off.
OSMO_CHAT=
# Gur's Supabase user id (Authentication > Users > his row's UID). Not a secret. Empty means nobody
# may use /api/chat.
OSMO_OWNER_ID=
# Optional. Empty means /api/chat uses the voice's key above (OPENAI_API_KEY, or CHATGPT_KEY),
# and so the voice's OpenAI project. The free daily tokens apply only if that project has data
# sharing on; otherwise the conversation is billed, up to the project's spend limit. Set this
# only to give the conversation its own project.
OSMO_CHAT_OPENAI_KEY=
# A dated model snapshot from the allowlist in lib/chat/allowance.ts.
# Empty means gpt-5.4-mini-2026-03-17.
OSMO_CHAT_MODEL=
# Osmo's share of the small-model pool per UTC day, in digits only (Gur's share is 700000).
# Empty or malformed means off.
OSMO_MINI_TOKENS_PER_DAY=
# The share of that cap kept back as a safety margin, written as 0 or 0.something. Empty means 0.1.
OSMO_TOKENS_RESERVE=

# Osmo builds small React things (artifacts): /api/build and /api/artifacts, and the build action. Server-only.
# "on" (exactly) enables them; anything else is off. Also needs OSMO_CHAT=on, OSMO_ACTIONS=on, the
# artifacts table (docs/migrations/artifacts-phase-1.sql) and "Building things" set to Act in Settings.
OSMO_BUILD=

# Osmo's cloud voice limits (/api/speak). Only OSMO_OWNER_ID above may use it.
# The most characters Osmo may speak per UTC day, in digits only. Empty or malformed means 20000.
# The count is kept per server instance and resets when one restarts, so it is a brake, not a
# hard limit. The real limit is the spend limit on the OpenAI project.
OSMO_SPEAK_CHARS_PER_DAY=

# The reminder timer (/api/cron/due). Server-only: it must NOT start with NEXT_PUBLIC_.
# A long random string you make up (for example 40 random characters). The same value goes in
# two places: here (Vercel Production) and in Supabase Vault under the name OSMO_CRON_SECRET, from
# which the timer reads it (docs/migrations/connectors-timer.sql). Empty means the route answers 404
# and no reminder is ever sent.
OSMO_CRON_SECRET=

# Osmo's actions (reminders and the other things he does for Gur). Server-only. "on" (exactly) turns
# them on; anything else is off and every action function returns before it touches the database.
OSMO_ACTIONS=

# Web Push for reminders, all three server-only. Push is on only when all three are set.
# The VAPID key pair (generate one with: npx web-push generate-vapid-keys). The private key is a secret.
OSMO_VAPID_PRIVATE=
# The public half of that pair. Handed to the browser by /api/push/key after sign-in, so it is not a NEXT_PUBLIC_ name.
OSMO_VAPID_PUBLIC=
# A contact for the push service, as a mailto: address (for example mailto:you@example.com).
OSMO_VAPID_SUBJECT=

# The share of the large-model pool per UTC day, in digits only. Only used if OSMO_CHAT_MODEL names a
# large-pool model. Empty or malformed means off (see lib/chat/allowance.ts).
OSMO_LARGE_TOKENS_PER_DAY=

# Shell v2 (the rail on the left, a bar on phones). Public: it is inlined at build time, so change it
# and rebuild. "on" (exactly) turns it on; anything else is off.
NEXT_PUBLIC_OSMO_SHELL2=
# Demo switch, public and inlined at build time. "1" makes every message count as a new day, so the
# bond's stages show within about 30 messages. Leave empty in production.
NEXT_PUBLIC_OSMO_DEMO=

# The Supabase service-role key. Server only: never put it in a NEXT_PUBLIC_ name, since it bypasses
# row-level security. Read only in lib/server/admin.ts, which pins every query to OSMO_OWNER_ID.
SUPABASE_SERVICE_ROLE_KEY=
